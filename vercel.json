{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60,
      "excludeFiles": "{.cache/**,.git/**,.github/**,.phpunit.cache/**,node_modules/**,tests/**,docs/**,supabase/**,storage/**,.env,.env.*,vercel.json,.vercelignore}"
    }
  },
  "routes": [
    {
      "src": "/assets/((?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\\.(?:css|js|png|jpg|jpeg|webp|gif|svg|ico|woff|woff2))$",
      "dest": "/assets/$1"
    },
    {"src": "/(.*)", "dest": "/api/index.php"}
  ],
  "git": {"deploymentEnabled": false}
}
