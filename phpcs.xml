<?xml version="1.0"?>
<ruleset name="BuligAI">
    <description>PSR-12 conventions for the modular PHP application.</description>
    <rule ref="PSR12"/>
    <file>api</file>
    <file>app</file>
    <file>bootstrap</file>
    <file>config</file>
    <file>public</file>
    <file>routes</file>
    <file>scripts</file>
    <file>tests</file>
    <exclude-pattern>*/Views/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
</ruleset>
