APP_NAME=BuligAI
APP_ENV=local
APP_URL=http://localhost:8000

# Local development uses file sessions. Vercel always uses encrypted cookies.
SESSION_DRIVER=file
# Required on Vercel: generate once with php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# Keep this server-only secret stable across deployments.
APP_KEY=

# Project URL and publishable key from Supabase > Settings > API Keys.
# Never use a service_role or sb_secret key for user file operations.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=community-files

# PHPMailer is for application notifications. Supabase Auth SMTP is separate.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="BuligAI Community"

# Reserved for the future AI module; not used by the starter.
GEMINI_API_KEY=
