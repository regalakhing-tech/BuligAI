{
    "name": "buligai/community-platform",
    "description": "Community service guides and private file management for Antique.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.5.0",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.10",
        "phpmailer/phpmailer": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {"psr-4": {"BuligAI\\": "app/"}},
    "autoload-dev": {"psr-4": {"BuligAI\\Tests\\": "tests/"}},
    "scripts": {
        "serve": "@php -d upload_max_filesize=10M -d post_max_size=11M -S localhost:8000 -t public public/router.php",
        "lint": "@php scripts/lint.php",
        "vercel": "@composer check-platform-reqs --no-dev",
        "smoke": "@php scripts/http-smoke.php",
        "style": "phpcs",
        "style:fix": "phpcbf",
        "test": "phpunit",
        "check": ["@lint", "@style", "@test"],
        "mail:test": "@php scripts/mail-test.php"
    },
    "config": {"sort-packages": true, "allow-plugins": false}
}
